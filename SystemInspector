#!/usr/bin/env bash
# Launch System Inspector as a desktop app (window + local backend).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

ensure_venv() {
  if [[ ! -d .venv ]]; then
    # system-site-packages so apt-installed python3-gi (GTK) is visible
    python3 -m venv --system-site-packages .venv
    .venv/bin/pip install -U pip
    .venv/bin/pip install -r requirements.txt
    return
  fi
  # Older venvs were created without system packages — fix if possible
  if [[ -f .venv/pyvenv.cfg ]] && grep -q 'include-system-site-packages = false' .venv/pyvenv.cfg; then
    sed -i 's/include-system-site-packages = false/include-system-site-packages = true/' .venv/pyvenv.cfg || true
  fi
}

ensure_venv

# shellcheck disable=SC1091
source .venv/bin/activate
pip install -q -r requirements.txt

# Clear window dependencies check with a helpful message
if ! python -c "import gi" 2>/dev/null; then
  echo "Missing Python GTK bindings (gi)."
  echo "Install once, then re-run ./SystemInspector:"
  echo "  sudo apt install python3-gi python3-gi-cairo gir1.2-gtk-3.0 gir1.2-webkit2-4.1"
  echo
fi

if ! python -c "import gi; gi.require_version('WebKit2','4.1'); from gi.repository import WebKit2" 2>/dev/null \
   && ! python -c "import gi; gi.require_version('WebKit2','4.0'); from gi.repository import WebKit2" 2>/dev/null; then
  echo "Missing WebKit for the native window (browser fallback will be used otherwise)."
  echo "Install once:"
  echo "  sudo apt install gir1.2-webkit2-4.1"
  echo
fi

exec python desktop_app.py
