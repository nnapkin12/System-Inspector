#!/usr/bin/env bash
# System Inspector CLI — personalized names (same program).
#   ./sysinspect gpu
#   ./si cpu temp
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# shellcheck disable=SC1091
source "$ROOT/setup-venv.sh"
if ! venv_has_pip; then
  echo "→ Setting up Python virtualenv + dependencies…"
  ensure_venv
  install_python_deps
fi

# shellcheck disable=SC1091
source .venv/bin/activate
exec python "$ROOT/sysinspect.py" "$@"
